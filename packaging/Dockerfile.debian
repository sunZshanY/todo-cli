FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake dpkg-dev file libsqlite3-dev python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
CMD ["sh", "-c", "sh /src/scripts/build-deb.sh /build && cp /build/packages/*.deb /out/"]
